DATABASE_URL=""
SHADOW_DATABASE_URL=""

# Auth related vars
JWKS_URI=""
ENABLE_AUTH=false

# Core Service Vars
IDENTITY_BASE_URL= # URL of the identity service to facilitate DID creation

# Service VARS
PORT=3000
SCHEMA_BASE_URL=

# true: schema ids get a keyless DID document in identity-service so they resolve.
# false (default): ids are minted without a DID document.
RESOLVABLE_SCHEMA_IDS=false
