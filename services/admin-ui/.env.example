REGISTRY_BASE_URL=http://registry:8081
CLAIM_MS_BASE_URL=http://claim-ms:8082
CREDENTIAL_SCHEMA_BASE_URL=http://credential-schema:3333
CREDENTIALS_BASE_URL=http://credential:3000
IDENTITY_BASE_URL=http://identity:3332
OID4VC_BASE_URL=http://oid4vc-service:3400

# Mirror the SAME env vars the backend containers read (docker-compose.yml) —
# one flip should update backend and admin-ui gating together.
CLAIMS_ENABLED=false
FILESSTORAGE_ENABLED=false
AUTHENTICATION_ENABLED=false
IDGEN_ENABLED=false
SIGNATURE_ENABLED=false

# admin-ui's own console-level auth (Phase 1) — independent of the backend
# flags above.
ADMIN_UI_AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://keycloak:8080/auth/realms/sunbird-rc
