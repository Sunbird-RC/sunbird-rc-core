DATABASE_URL=""
SCHEMA_BASE_URL=""

# Auth related vars
JWKS_URI=""
ENABLE_AUTH=false

# Core Service Vars
IDENTITY_BASE_URL= # URL of the identity service to facilitate DID creation

# Service VARS
SCHEMA_BASE_URL=

CREDENTIAL_SERVICE_BASE_URL=""

# Public HTTPS base URL of this service, reachable by external verifiers.
# Used to build the SD-JWT status.status_list.uri (the IETF Token Status
# List token URL). Must be HTTPS and publicly reachable — verifiers fetch
# it to check revocation. Falls back to CREDENTIAL_SERVICE_BASE_URL when
# unset, but that is the internal Docker address (http://credential:3000)
# in the standard deployment and is NOT reachable by external verifiers.
CREDENTIAL_SERVICE_PUBLIC_URL=""
