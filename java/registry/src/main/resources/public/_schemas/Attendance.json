{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "Attendance": { "$ref": "#/definitions/Attendance" }
  },
  "required": ["Attendance"],
  "title": "Attendance",
  "definitions": {
    "Attendance": {
      "$id": "#/properties/Attendance",
      "type": "object",
      "title": "The Attendance Schema",
      "required": ["studentOsid", "date", "status"],
      "properties": {
        "studentOsid": { "type": "string", "title": "Student OSID" },
        "courseName": { "type": "string", "title": "Course Name" },
        "date": { "type": "string", "format": "date", "title": "Date" },
        "status": {
          "type": "string",
          "title": "Attendance Status",
          "enum": ["PRESENT", "ABSENT", "LATE", "EXCUSED"]
        },
        "remarks": { "type": "string", "title": "Remarks" }
      }
    }
  },
  "_osConfig": {
    "privateFields": [],
    "internalFields": [],
    "signedFields": [],
    "indexFields": ["studentOsid", "date"],
    "systemFields": [
      "_osCreatedAt", "_osUpdatedAt", "_osCreatedBy", "_osUpdatedBy",
      "_osAttestedData", "_osClaimId", "_osState"
    ],
    "ownedReferences": { "studentOsid": "Student" },
    "inviteRoles": ["anonymous"],
    "roles": ["anonymous"]
  }
}
