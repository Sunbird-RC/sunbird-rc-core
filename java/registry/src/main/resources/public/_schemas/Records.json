{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "Records": { "$ref": "#/definitions/Records" }
  },
  "required": ["Records"],
  "title": "Records",
  "definitions": {
    "Records": {
      "$id": "#/properties/Records",
      "type": "object",
      "title": "The Records Schema",
      "required": ["studentOsid", "courseName", "completionStatus", "percentage"],
      "properties": {
        "studentOsid": { "type": "string", "title": "Student OSID" },
        "program": { "type": "string", "title": "Program" },
        "courseName": { "type": "string", "title": "Course Name" },
        "enrollmentDate": { "type": "string", "format": "date", "title": "Enrollment Date" },
        "completionStatus": {
          "type": "string",
          "title": "Completion Status",
          "enum": ["COMPLETED", "IN_PROGRESS", "DISCONTINUED", "FAILED"]
        },
        "percentage": {
          "type": "number",
          "title": "Percentage",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "_osConfig": {
    "privateFields": [],
    "internalFields": [],
    "signedFields": [],
    "indexFields": ["studentOsid", "courseName"],
    "systemFields": [
      "_osCreatedAt", "_osUpdatedAt", "_osCreatedBy", "_osUpdatedBy",
      "_osAttestedData", "_osClaimId", "_osState"
    ],
    "ownedReferences": { "studentOsid": "Student" },
    "inviteRoles": ["anonymous"],
    "roles": ["anonymous"]
  }
}
