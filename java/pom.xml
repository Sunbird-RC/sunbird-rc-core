<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.sunbirdrc</groupId>
    <artifactId>sunbird-rc</artifactId>
    <version>2.0.3</version>
    <name>Open Software for Building Electronic Registries</name>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <junit.version>4.12</junit.version>
        <neo4j.version>3.2.3</neo4j.version>
        <jacoco.version>0.8.1</jacoco.version>

        <revision>2.0.3</revision>

        <jsonldConversionVersion>${revision}</jsonldConversionVersion>
        <authorizationVersion>${revision}</authorizationVersion>
        <validationVersion>${revision}</validationVersion>
        <signaturePresenceValidationVersion>${revision}</signaturePresenceValidationVersion>

    </properties>

    <modules>
        <module>pojos</module>
        <module>middleware-commons</module>
        <module>middleware</module>
        <module>validators</module>
        <module>registry-interceptor</module>
        <module>registry</module>
        <module>elastic-search</module>
		<module>view-templates</module>
        <module>sunbirdrc-actors</module>
        <module>sunbird-actor</module>
        <module>claim</module>
        <module>apitest</module>
        <module>plugins</module>
  </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 2.18.8, not 2.15.4: 2.15.4 alone still leaves CVE-2026-59888
                 (async-parser number-length DoS) and GHSA-72hv-8253-57qq
                 (@JsonIgnore bypass on Java records) open. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.18.8</version>
            </dependency>
            <!-- 2.18.9, one patch ahead of jackson-core/-annotations: closes
                 CVE-2026-59889 / GHSA-mhm7-754m-9p8w, disclosed against 2.18.8 itself. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.18.9</version>
            </dependency>
            <!-- Newer jackson-databind (2.15+) proactively detects java.util.Optional and
                 throws InvalidDefinitionException directing callers to this module, rather
                 than the older versions' fallback bean-style (de)serialization — needed by
                 sunbirdrc-actors' MessageFactory, whose plain `new ObjectMapper()` calls
                 serialize PluginRequestMessage.actorName (an Optional<String>). -->
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jdk8</artifactId>
                <version>2.18.9</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.18.8</version>
            </dependency>
            <!-- json-path 2.4.0 is incompatible with Jackson 2.12+; 2.7.0 fixes the NPE and is compatible with Spring Data Commons 2.7.x (2.9.0 breaks Spring Data 2.7.x) -->
            <dependency>
                <groupId>com.jayway.jsonpath</groupId>
                <artifactId>json-path</artifactId>
                <version>2.7.0</version>
            </dependency>
            <!-- CVE-2025-24813, CVE-2025-29145: tomcat-embed → 9.0.116 (covers modules without SB parent) -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>9.0.116</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>9.0.116</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>9.0.116</version>
            </dependency>
            <!-- CVE-2024-22243/22259/22262, CVE-2024-38808/38809/38828: spring-framework →
                 5.3.39 (last 5.3.x release; several newer Spring Framework CVEs in this tree
                 only have 6.x/7.x fixes and need Java 17 — out of scope while pinned to Java 11) -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-web</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-webmvc</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-core</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-expression</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-beans</artifactId>
                <version>5.3.39</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-context</artifactId>
                <version>5.3.39</version>
            </dependency>
            <!-- CVE-2017-18640, CVE-2022-25857/38749/38750/38751/38752/41854: snakeyaml → 1.33
                 (last 1.x release; CVE-2022-1471 needs the 2.x Constructor/Loader API rework —
                 not a drop-in bump, left for a follow-up pass with compatibility testing) -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>1.33</version>
            </dependency>
            <!-- CVE-2023-6378, CVE-2023-6481: logback → 1.2.13 (stays on 1.2.x for Java 11 / Spring Boot 2.7) -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>1.2.13</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>1.2.13</version>
            </dependency>
            <!-- CVE-2023-1370: json-smart → 2.5.2 (2.4.9's fix for this CVE added a JSON-nesting-depth
                 guard, but its depth counter double-counted flat arrays with >400 elements as "too
                 deep" and rejected legitimate payloads with "Malicious payload, having non natural
                 depths" — fixed in 2.4.10. 2.5.2 also carries the CVE-2024-57699 fix on top.) -->
            <dependency>
                <groupId>net.minidev</groupId>
                <artifactId>json-smart</artifactId>
                <version>2.5.2</version>
            </dependency>
            <dependency>
                <groupId>net.minidev</groupId>
                <artifactId>accessors-smart</artifactId>
                <version>2.5.2</version>
            </dependency>
            <!-- CVE-2020-28491: jackson-dataformat-cbor → align with the jackson-core/databind pin above -->
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-cbor</artifactId>
                <version>2.18.8</version>
            </dependency>
            <!-- CVE-2021-35515/35516/35517/36090, CVE-2024-25710: commons-compress → 1.26.0 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.26.0</version>
            </dependency>
            <!-- CVE-2024-47554: commons-io → 2.14.0 -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.14.0</version>
            </dependency>
            <!-- CVE-2021-43859, CVE-2022-40151/41966, CVE-2024-47072: xstream → 1.4.21 -->
            <dependency>
                <groupId>com.thoughtworks.xstream</groupId>
                <artifactId>xstream</artifactId>
                <version>1.4.21</version>
            </dependency>
            <!-- CVE-2022-45688, CVE-2023-5072: org.json → 20231013 -->
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>20231013</version>
            </dependency>
            <!-- CVE-2022-25647: gson → 2.8.9 -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>2.8.9</version>
            </dependency>
            <!-- CVE-2021-22569, CVE-2022-3171/3509/3510, CVE-2024-7254: protobuf-java → 3.25.5 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>3.25.5</version>
            </dependency>
            <!-- CVE-2024-31141, CVE-2025-27817, CVE-2026-33558/35554: kafka-clients → 3.9.2 -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>3.9.2</version>
            </dependency>
            <!-- CVE-2023-34040: spring-kafka → 2.9.13 (last 2.9.x release; CVE-2026-41726/41731
                 only have 3.x/4.x fixes and need a Spring Boot 3 upgrade) -->
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka</artifactId>
                <version>2.9.13</version>
            </dependency>
            <!-- CVE-2026-54291: postgresql → 42.7.12 (PR #363 pinned 42.7.11; a newer patch fixing
                 a SCRAM-SHA-256-PLUS MITM downgrade has since shipped) -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.12</version>
            </dependency>
            <!-- CVE-2026-44249/44250/44890/44893/45416/48006/48059/50010/50011/50020/55831/55833/
                 55851/56745/56746/56820/56821/56822/59898/59899/59919/59921: netty 4.1.x codec/handler
                 artifacts → 4.1.136.Final (last 4.1.x release; the netty 4.x major line, not the
                 unrelated ancient io.netty:netty 3.10.6.Final artifact used elsewhere in this tree,
                 which has no fix in the 3.x line at all) -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-http</artifactId>
                <version>4.1.136.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-redis</artifactId>
                <version>4.1.136.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-haproxy</artifactId>
                <version>4.1.136.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-handler</artifactId>
                <version>4.1.136.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-handler-ssl-ocsp</artifactId>
                <version>4.1.136.Final</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M5</version>
            </plugin>
        </plugins>
    </build>

</project>